# Optional: enables real AI feedback. Without these, the app uses built-in local coaching rules.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01

# Production (not used by the demo build): Postgres connection for the Prisma schema in /prisma
DATABASE_URL=postgresql://user:password@localhost:5432/careerforge
NEXT_PUBLIC_SITE_URL=http://localhost:3000
