{
  "name": "beacon",
  "version": "0.1.0",
  "private": true,
  "description": "Beacon - a South African youth platform for employment readiness, money confidence, and growth",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:web": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:reset": "npx --yes supabase start --exclude gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor && npx --yes supabase db reset",
    "db:test": "npx --yes supabase test db"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.451.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0"
  }
}
