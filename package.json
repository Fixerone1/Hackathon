{
  "name": "careerforge",
  "version": "0.1.0",
  "private": true,
  "description": "CareerForge AI - a Youth Economic Mobility Platform (employment readiness, money confidence, entrepreneurship)",
  "scripts": {
    "dev": "concurrently -k -n web,auth \"next dev --hostname 0.0.0.0\" \"python3 -m uvicorn auth_service.main:app --host 127.0.0.1 --port 8000 --reload\"",
    "dev:web": "next dev --hostname 0.0.0.0",
    "dev:auth": "python3 -m uvicorn auth_service.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "next build",
    "test:python": "python3 -m unittest discover -s tests -v",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide-react": "^0.451.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0"
  }
}
